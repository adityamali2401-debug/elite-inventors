# Optional personal access token. Keep the real value in .env, never in frontend JavaScript.
# A token increases GitHub REST API rate limits and can access private repositories
# only if its owner has granted that token suitable permissions.
GITHUB_TOKEN=

# Comma-separated origins allowed to call this API from a browser.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

# Configure the exact installed Gemma model tag shown by `ollama list`.
# No Gemma version or size is assumed by the application.
GEMMA_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_CTX=8192
